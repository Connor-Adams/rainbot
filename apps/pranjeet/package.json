{
  "name": "@rainbot/pranjeet-worker",
  "version": "1.0.0",
  "description": "Pranjeet TTS worker bot",
  "private": true,
  "main": "dist/apps/pranjeet/src/index.js",
  "scripts": {
    "build": "npm run build:ts",
    "build:ts": "tsc && tsc-alias -p tsconfig.json",
    "dev": "npm run build && node dist/apps/pranjeet/src/index.js",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "start": "node dist/apps/pranjeet/src/index.js",
    "type-check": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.0",
    "@opentelemetry/api": "^1.9.1",
    "@rainbot/db": "*",
    "@rainbot/observability": "*",
    "@rainbot/protocol": "*",
    "@rainbot/rpc": "*",
    "@rainbot/shared": "*",
    "@rainbot/utils": "*",
    "@rainbot/worker-shared": "*",
    "@snazzah/davey": "^0.1.12",
    "@trpc/server": "^10.45.2",
    "bullmq": "^5.17.0",
    "discord.js": "^14.25.1",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "ioredis": "^5.4.1",
    "opusscript": "^0.1.1",
    "prism-media": "^1.3.4",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "@google-cloud/text-to-speech": "^5.8.0",
    "openai": "^4.104.0"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "^2.7.1",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.0.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.3"
  }
}
