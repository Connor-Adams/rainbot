# envsubst'd by the nginx image's entrypoint (20-envsubst-on-templates.sh), so
# ${PORT} is substituted at container start. Bare $uri has no braces and is left
# alone for nginx itself.
server {
  listen ${PORT};
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # SPA fallback: React Router needs unknown paths to return index.html
  location / {
    try_files $uri $uri/ /index.html;
  }

  # Vite produces content-hashed asset filenames; safe to cache forever
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  # runtime-config.js is rewritten from env on every boot (see
  # 30-runtime-config.sh) and index.html points at the current asset hashes —
  # caching either one strands the app on a stale API base or a dead bundle.
  # sw.js must revalidate too, or the old service worker keeps serving itself.
  location ~ ^/(index\.html|runtime-config\.js|sw\.js)$ {
    expires -1;
    add_header Cache-Control "no-cache, no-store, must-revalidate";
  }
}
